{
  "expo": {
    "name": "CrossNav",
    "slug": "crossnav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": ["expo-location", "expo-task-manager"],
    "android": {
      "package": "com.crossnav.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_LOCATION"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crossnav.app",
      "infoPlist": { "UIBackgroundModes": ["location"] }
    },
    "web": { "favicon": "./assets/favicon.png" }
  }
}
